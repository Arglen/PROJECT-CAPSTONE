<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".SystemMiniCapstoneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.System_mini_capstone">
        <activity
            android:name=".CrashDebugActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".translator.TranslatorActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.AdminAnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.SystemConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.MaintenanceActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.UserManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.lcms.LessonListActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".admin.lcms.LessonEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.System_mini_capstone" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.System_mini_capstone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>